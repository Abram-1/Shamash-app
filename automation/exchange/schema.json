{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHAMASH agent exchange V1 — synthetic structural pilot",
  "oneOf": [
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/implementation_result"
    },
    {
      "$ref": "#/$defs/independent_review"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "role": {
          "enum": [
            "owner",
            "coordinator",
            "implementer",
            "reviewer"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "SHAMASH_AGENT_EXCHANGE_V1"
        },
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "kind": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "producer": {
          "$ref": "#/$defs/actor"
        },
        "recipient": {
          "$ref": "#/$defs/actor"
        },
        "status": {
          "enum": [
            "PROPOSED",
            "BLOCKED"
          ]
        },
        "data_classification": {
          "const": "SYNTHETIC"
        },
        "owner_decision": {
          "const": "REQUIRED_NOT_GRANTED"
        },
        "payload": {
          "type": "object",
          "properties": {
            "allowed_actions": {
              "type": "array",
              "items": {
                "enum": [
                  "READ_SYNTHETIC",
                  "WRITE_ALLOWED_FILES",
                  "RUN_SYNTHETIC_TESTS",
                  "REPORT"
                ]
              },
              "maxItems": 100,
              "minItems": 1
            },
            "allowed_files": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^automation/synthetic/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.[A-Za-z0-9]+$"
              },
              "maxItems": 100,
              "minItems": 1
            },
            "acceptance_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "maxItems": 100,
              "minItems": 1
            },
            "reviewer": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{1,63}$"
                },
                "role": {
                  "enum": [
                    "owner",
                    "coordinator",
                    "implementer",
                    "reviewer"
                  ]
                }
              },
              "required": [
                "id",
                "role"
              ],
              "additionalProperties": false
            },
            "authorization_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "allowed_actions",
            "allowed_files",
            "acceptance_checks",
            "reviewer",
            "authorization_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "schema_version",
        "record_id",
        "kind",
        "task_id",
        "commit_sha",
        "producer",
        "recipient",
        "status",
        "data_classification",
        "owner_decision",
        "payload"
      ],
      "additionalProperties": false
    },
    "implementation_result": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "SHAMASH_AGENT_EXCHANGE_V1"
        },
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "kind": {
          "const": "implementation_result"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "producer": {
          "$ref": "#/$defs/actor"
        },
        "recipient": {
          "$ref": "#/$defs/actor"
        },
        "status": {
          "enum": [
            "READY_FOR_INDEPENDENT_REVIEW",
            "BLOCKED"
          ]
        },
        "data_classification": {
          "const": "SYNTHETIC"
        },
        "owner_decision": {
          "const": "REQUIRED_NOT_GRANTED"
        },
        "payload": {
          "type": "object",
          "properties": {
            "task_record_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
            },
            "changed_files": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^automation/synthetic/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.[A-Za-z0-9]+$"
              },
              "maxItems": 100
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "result": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_RUN"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "name",
                  "result",
                  "evidence_ref"
                ],
                "additionalProperties": false
              },
              "maxItems": 100
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "maxItems": 100
            },
            "execution_provenance": {
              "const": "SIMULATED_NOT_AN_AGENT_RUN"
            }
          },
          "required": [
            "task_record_id",
            "changed_files",
            "tests",
            "limitations",
            "execution_provenance"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "schema_version",
        "record_id",
        "kind",
        "task_id",
        "commit_sha",
        "producer",
        "recipient",
        "status",
        "data_classification",
        "owner_decision",
        "payload"
      ],
      "additionalProperties": false
    },
    "independent_review": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "SHAMASH_AGENT_EXCHANGE_V1"
        },
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "kind": {
          "const": "independent_review"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "producer": {
          "$ref": "#/$defs/actor"
        },
        "recipient": {
          "$ref": "#/$defs/actor"
        },
        "status": {
          "enum": [
            "REVIEWED",
            "BLOCKED",
            "NOT_REVIEWED"
          ]
        },
        "data_classification": {
          "const": "SYNTHETIC"
        },
        "owner_decision": {
          "const": "REQUIRED_NOT_GRANTED"
        },
        "payload": {
          "type": "object",
          "properties": {
            "implementation_record_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
            },
            "verdict": {
              "enum": [
                "PASS",
                "PASS_WITH_FINDINGS",
                "FAIL",
                "BLOCKED",
                "NOT_REVIEWED"
              ]
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "enum": [
                      "BLOCKING",
                      "MAJOR",
                      "MINOR"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "recommendation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "severity",
                  "evidence",
                  "recommendation"
                ],
                "additionalProperties": false
              },
              "maxItems": 100
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "maxItems": 100
            },
            "execution_provenance": {
              "const": "SIMULATED_NOT_AN_AGENT_RUN"
            },
            "independence_status": {
              "const": "NOT_VERIFIED"
            }
          },
          "required": [
            "implementation_record_id",
            "verdict",
            "findings",
            "limitations",
            "execution_provenance",
            "independence_status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "schema_version",
        "record_id",
        "kind",
        "task_id",
        "commit_sha",
        "producer",
        "recipient",
        "status",
        "data_classification",
        "owner_decision",
        "payload"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "type": {
          "enum": [
            "RECORD_ADDED",
            "CLAIMED",
            "COMPLETED",
            "BLOCKED"
          ]
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "consumer_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "previous_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "const": "LOCAL_SYNTHETIC_EXCHANGE_ONLY"
        }
      },
      "required": [
        "schema_version",
        "sequence",
        "event_id",
        "type",
        "record_id",
        "task_id",
        "commit_sha",
        "record_sha256",
        "consumer_id",
        "previous_hash",
        "event_hash",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
